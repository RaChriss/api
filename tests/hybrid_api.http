### Tests de l'API Hybride Firebase/PostgreSQL
### Fichier: tests/hybrid_api.http

###############################################
# Variables
###############################################

@baseUrl = http://localhost:3000/api
@authToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
@managerId = 1

###############################################
# 1. Tests de Santé et Statut
###############################################

### Vérifier la santé de l'API
GET {{baseUrl}}/../health
Accept: application/json

### Informations sur l'API hybride
GET {{baseUrl}}
Accept: application/json

### Vérifier le statut Firebase
GET {{baseUrl}}/firebase/status
Accept: application/json

###############################################
# 2. Tests d'Authentification
###############################################

### Inscription d'un utilisateur
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nom": "Testeur",
  "prenom": "API",
  "email": "testeur.api@example.com",
  "password": "password123",
  "Id_type_user": 2
}

### Connexion utilisateur
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "testeur.api@example.com",
  "password": "password123"
}

### Informations utilisateur connecté
GET {{baseUrl}}/auth/me
Authorization: Bearer {{authToken}}

###############################################
# 3. Tests de Synchronisation (Manager uniquement)
###############################################

### Vérifier le statut de synchronisation
GET {{baseUrl}}/admin/sync/status
Authorization: Bearer {{authToken}}
Accept: application/json

### Déclencher la synchronisation manuelle
POST {{baseUrl}}/admin/sync/execute
Authorization: Bearer {{authToken}}
Content-Type: application/json

### Synchroniser uniquement les signalements
POST {{baseUrl}}/firebase/sync/signalements
Authorization: Bearer {{authToken}}
Content-Type: application/json

### Synchroniser uniquement les utilisateurs
POST {{baseUrl}}/firebase/sync/users
Authorization: Bearer {{authToken}}
Content-Type: application/json

### Obtenir le statut de sync détaillé
GET {{baseUrl}}/firebase/sync-status
Authorization: Bearer {{authToken}}

###############################################
# 4. Tests de Création de Données (Mode Hybride)
###############################################

### Créer un signalement (sera routé automatiquement selon la connexion)
POST {{baseUrl}}/signalements
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "location": {
    "latitude": -18.8792,
    "longitude": 47.5079
  },
  "description": "Nid-de-poule important sur la route principale",
  "photo_url": "https://example.com/photo.jpg"
}

### Lister les signalements (source automatique)
GET {{baseUrl}}/signalements
Authorization: Bearer {{authToken}}
Accept: application/json

### Obtenir un signalement spécifique
GET {{baseUrl}}/signalements/1
Authorization: Bearer {{authToken}}
Accept: application/json

###############################################
# 5. Tests des Headers de Réponse
###############################################

### Vérifier les headers de mode de données
GET {{baseUrl}}/signalements
Authorization: Bearer {{authToken}}
# Vérifier dans la réponse :
# X-Data-Source: firebase | postgres
# X-Firebase-Status: connected | offline | error
# X-Fallback-Used: true | false

###############################################
# 6. Tests Firebase Direct
###############################################

### Lister tous les signalements Firebase
GET {{baseUrl}}/firebase/signalements
Authorization: Bearer {{authToken}}

### Obtenir un signalement Firebase spécifique
GET {{baseUrl}}/firebase/signalements/firebase-doc-id
Authorization: Bearer {{authToken}}

### Vérifier un token Firebase
POST {{baseUrl}}/firebase/verify-token
Content-Type: application/json

{
  "idToken": "firebase-id-token-here"
}

### Créer un utilisateur Firebase
POST {{baseUrl}}/firebase/create-user
Content-Type: application/json

{
  "email": "nouveau.user@example.com",
  "password": "password123",
  "displayName": "Nouveau Utilisateur",
  "phoneNumber": "+261340000000"
}

###############################################
# 7. Tests Administration
###############################################

### Lister les utilisateurs bloqués
GET {{baseUrl}}/admin/users/blocked
Authorization: Bearer {{authToken}}

### Bloquer un utilisateur
POST {{baseUrl}}/admin/users/2/block
Authorization: Bearer {{authToken}}

### Débloquer un utilisateur  
POST {{baseUrl}}/admin/users/2/unblock
Authorization: Bearer {{authToken}}

### Statistiques des sessions
GET {{baseUrl}}/admin/sessions/stats
Authorization: Bearer {{authToken}}

### Nettoyer les sessions expirées
POST {{baseUrl}}/admin/sessions/cleanup
Authorization: Bearer {{authToken}}

###############################################
# 8. Tests de Simulation de Panne
###############################################

### Test en mode hors ligne (nécessite SIMULATE_OFFLINE=true dans .env)
# 1. Modifier .env: SIMULATE_OFFLINE=true
# 2. Redémarrer le serveur
# 3. Refaire les tests de création de signalements
# 4. Vérifier que les données vont dans PostgreSQL
# 5. Vérifier que est_synchronise=FALSE

### Vérifier les données non synchronisées
GET {{baseUrl}}/admin/sync/status
Authorization: Bearer {{authToken}}
# Devrait montrer pending_signalements > 0

### Remettre en ligne et synchroniser
# 1. Modifier .env: SIMULATE_OFFLINE=false  
# 2. Redémarrer le serveur
# 3. Exécuter la synchronisation
POST {{baseUrl}}/admin/sync/execute
Authorization: Bearer {{authToken}}

###############################################
# 9. Tests de Monitoring
###############################################

### Vérifier les logs de synchronisation (requête SQL directe)
# SELECT * FROM SyncLog ORDER BY sync_date DESC LIMIT 10;

### Statistiques de synchronisation  
# SELECT * FROM get_sync_statistics(7);

### Statut général
# SELECT * FROM v_sync_status;

### Données non synchronisées
# SELECT * FROM v_signalements_non_synchronises LIMIT 5;
# SELECT * FROM v_users_non_synchronises LIMIT 5;

###############################################
# 10. Tests de Performance
###############################################

### Création en lot (teste la performance du mode hybride)
POST {{baseUrl}}/signalements
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "location": {"latitude": -18.8792, "longitude": 47.5079},
  "description": "Test 1"
}

###

POST {{baseUrl}}/signalements  
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "location": {"latitude": -18.8793, "longitude": 47.5080},
  "description": "Test 2"
}

###

POST {{baseUrl}}/signalements
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "location": {"latitude": -18.8794, "longitude": 47.5081},
  "description": "Test 3"
}

###############################################
# Notes d'utilisation :
# 
# 1. Remplacer {{authToken}} par un vrai token obtenu via login
# 2. Ajuster {{baseUrl}} selon votre configuration
# 3. Pour les tests hors ligne, modifier .env et redémarrer
# 4. Vérifier les headers X-Data-Source dans les réponses
# 5. Surveiller les logs de console pour les basculements
# 6. Utiliser un compte Manager pour les tests de synchronisation
#
# Expected Headers dans les réponses :
# X-Data-Source: firebase | postgres
# X-Firebase-Status: connected | offline | error | available
# X-Fallback-Used: true (si basculement forcé)
# X-Sync-Mode: true (pour les endpoints de sync)
###############################################