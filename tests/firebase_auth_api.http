# ============================================
# Tests API Firebase Auth - Travaux Routiers
# Utiliser avec l'extension REST Client de VS Code
# ============================================

@baseUrl = http://localhost:3001/api
@contentType = application/json

# Note: Pour obtenir un Firebase ID Token, vous devez:
# 1. Vous connecter via Firebase SDK côté client
# 2. Appeler user.getIdToken() pour obtenir le token
# 3. Remplacer @firebaseToken ci-dessous par ce token

@firebaseToken = VOTRE_FIREBASE_ID_TOKEN_ICI

### ============================================
### HEALTH CHECK
### ============================================

### Vérifier que l'API fonctionne
GET http://localhost:3001/health

### Infos API
GET {{baseUrl}}

### ============================================
### AUTHENTIFICATION FIREBASE
### ============================================

### 1. Inscription d'un nouvel utilisateur (crée dans Firebase Auth + Firestore + PostgreSQL)
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "email": "nouveau.user@email.mg",
  "password": "motdepasse123",
  "displayName": "Nouveau Utilisateur"
}

### 2. Vérifier un Firebase ID Token (après connexion côté client)
# @name verifyToken
POST {{baseUrl}}/auth/verify-token
Content-Type: {{contentType}}

{
  "idToken": "{{firebaseToken}}"
}

### 3. Obtenir le profil utilisateur
GET {{baseUrl}}/auth/me
Authorization: Bearer {{firebaseToken}}

### 4. Mettre à jour le profil
PUT {{baseUrl}}/auth/update-profile
Authorization: Bearer {{firebaseToken}}
Content-Type: {{contentType}}

{
  "displayName": "Nouveau Nom"
}

### 5. Synchroniser le profil avec Firebase
POST {{baseUrl}}/auth/sync
Authorization: Bearer {{firebaseToken}}

### 6. Obtenir tous les types d'utilisateurs
GET {{baseUrl}}/auth/user-types

### 7. Obtenir un type d'utilisateur spécifique
GET {{baseUrl}}/auth/user-types/2

### ============================================
### ADMINISTRATION (Manager uniquement)
### ============================================

### Liste de tous les utilisateurs (cache local)
GET {{baseUrl}}/admin/users
Authorization: Bearer {{firebaseToken}}

### Liste des utilisateurs bloqués
GET {{baseUrl}}/admin/users/blocked
Authorization: Bearer {{firebaseToken}}

### Débloquer un utilisateur (par ID PostgreSQL)
POST {{baseUrl}}/admin/users/2/unblock
Authorization: Bearer {{firebaseToken}}

### Bloquer un utilisateur
POST {{baseUrl}}/admin/users/2/block
Authorization: Bearer {{firebaseToken}}

### Modifier le type d'un utilisateur (1=Visiteur, 2=Utilisateur, 3=Manager)
PUT {{baseUrl}}/admin/users/2/update-type
Authorization: Bearer {{firebaseToken}}
Content-Type: {{contentType}}

{
  "type_user": 2
}

### ============================================
### ADMINISTRATION FIREBASE
### ============================================

### Liste des utilisateurs Firebase Auth
GET {{baseUrl}}/admin/firebase/users
Authorization: Bearer {{firebaseToken}}

### Désactiver un utilisateur Firebase (par UID Firebase)
POST {{baseUrl}}/admin/firebase/users/FIREBASE_UID_ICI/disable
Authorization: Bearer {{firebaseToken}}

### Réactiver un utilisateur Firebase
POST {{baseUrl}}/admin/firebase/users/FIREBASE_UID_ICI/enable
Authorization: Bearer {{firebaseToken}}

### ============================================
### SYNCHRONISATION
### ============================================

### Statut de synchronisation
GET {{baseUrl}}/admin/sync/status
Authorization: Bearer {{firebaseToken}}

### Synchroniser tous les utilisateurs vers Firebase
POST {{baseUrl}}/admin/sync/users
Authorization: Bearer {{firebaseToken}}

### ============================================
### SIGNALEMENTS (exemples)
### ============================================

### Créer un signalement
POST {{baseUrl}}/signalements
Authorization: Bearer {{firebaseToken}}
Content-Type: {{contentType}}

{
  "latitude": -18.9167,
  "longitude": 47.5167,
  "description": "Nid de poule rue de l'Indépendance"
}

### Lister les signalements
GET {{baseUrl}}/signalements
Authorization: Bearer {{firebaseToken}}

### ============================================
### NOTES
### ============================================
# 
# Pour obtenir un Firebase ID Token, utilisez ce code JavaScript côté client:
#
# import { getAuth, signInWithEmailAndPassword } from 'firebase/auth';
# 
# const auth = getAuth();
# const userCredential = await signInWithEmailAndPassword(auth, email, password);
# const idToken = await userCredential.user.getIdToken();
# console.log('Firebase ID Token:', idToken);
#
# Ce token expire après 1 heure. Utilisez getIdToken(true) pour forcer un refresh.
